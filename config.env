CONFIG_ENV=config.env

KERNEL_SOURCE=https://github.com/MiCode/Xiaomi_Kernel_OpenSource
KERNEL_SOURCE_BRANCH=cezanne-r-oss
KERNEL_CONFIG=atom_user_defconfig
ARCH=arm64
KERNEL_IMAGE_NAME=Image

KERNEL_NAME=

ADD_LOCALVERSION_TO_FILENAME=false

ADD_KPROBES_CONFIG=true

KERNELSU_TAG=v0.9.5

USE_CLANG=true
CLANG_VERSION=12.0.5

BUILD_BOOT_IMG=true
SOURCE_BOOT_IMAGE=https://github.com/qwert18877047/atom-assets/releases/download/v1.2.3/boot.img
